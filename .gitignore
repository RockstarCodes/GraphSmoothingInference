.venv/
__pycache__/
*.pyc
.pytest_cache/
.ipynb_checkpoints/
.env
*.key
# LaTeX build files
*.aux
*.log
*.out
*.toc
*.nav
*.snm
*.vrb
*.synctex.gz
!results/logs/*.log
